>>>>>>> origin/release-2.1.3-beta2

def get_current_branch():
  try:
    result = subprocess.run(['git', 'branch'], capture_output=True, text=True, check=True)
    for line in result.stdout.splitlines():
      if line.startswith('*'):
        return line[2:]
  except subprocess.CalledProcessError:
    return None

